---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Sanatan Dharam Sewa Kendra | Education, Empowerment & Community Development"
  description="Sanatan Dharam Sewa Kendra supports education, vocational development, women empowerment, health awareness and community-development initiatives."
  canonicalPath="/"
>
  <section class="section placeholder-home">
    <div class="container">
      <h1>Building Stronger Communities Through Seva, Education & Empowerment</h1>
    </div>
  </section>
</MainLayout>

<style>
  .placeholder-home {
    display: grid;
    min-height: 70vh;
    align-items: center;
    padding-top: calc(var(--header-height) + 3rem);
  }
</style>
