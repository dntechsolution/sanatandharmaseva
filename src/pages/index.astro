---
import { ArrowRight } from '@lucide/astro';
import CTASection from '../components/CTASection.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Hero from '../components/Hero.astro';
import ProgramCard from '../components/ProgramCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatsStrip from '../components/StatsStrip.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { activities, testimonialPlaceholders } from '../data/activities';
import { focusAreas, programs } from '../data/programs';
import MainLayout from '../layouts/MainLayout.astro';

const impactPhilosophy = [
  { title: 'Education', description: 'Knowledge creates the foundation for informed choices.' },
  { title: 'Opportunity', description: 'Practical pathways help learning become possibility.' },
  { title: 'Empowerment', description: 'Confidence grows when people can participate and lead.' },
  { title: 'Community', description: 'Shared responsibility strengthens local action.' },
  { title: 'Environment', description: 'Sustainable habits protect everyday well-being.' },
];

const healthCampPhotos = [
  {
    image: '/images/health-camp/health-camp-1.jpg',
    alt: 'Seven organisers standing together at the health check-up camp venue',
    caption: 'Organisers and community partners',
  },
  {
    image: '/images/health-camp/health-camp-2.jpg',
    alt: 'Health camp attendees seated inside the banquet hall',
    caption: 'Community participation',
  },
  {
    image: '/images/health-camp/health-camp-3.jpg',
    alt: 'Medical professional performing a heart screening for a participant',
    caption: 'Preventive health screening',
  },
  {
    image: '/images/health-camp/health-camp-4.jpg',
    alt: 'Organisers standing beside the Sanatan Dharam Sewa Kendra health camp banner',
    caption: 'Health camp collaboration',
  },
  {
    image: '/images/health-camp/health-camp-5.jpg',
    alt: 'Health camp participants speaking with the registration coordinator',
    caption: 'Guidance and registration',
  },
  {
    image: '/images/health-camp/health-camp-6.jpg',
    alt: 'Medical worker checking a participant’s blood pressure',
    caption: 'Routine health checks',
  },
  {
    image: '/images/health-camp/health-camp-7.jpg',
    alt: 'Health camp medical team posing together beside the event banner',
    caption: 'Medical team and organisers',
  },
  {
    image: '/images/health-camp/health-camp-8.jpg',
    alt: 'Organisers and medical team gathered around the health check-up camp banner',
    caption: 'Working together for community health',
  },
];
---

<MainLayout
  title="Sanatan Dharam Sewa Kendra | Education, Empowerment & Community Development"
  description="Sanatan Dharam Sewa Kendra supports education, vocational development, women empowerment, health awareness and community-development initiatives."
  canonicalPath="/"
>
  <Hero
    eyebrow="SERVING COMMUNITIES • BUILDING FUTURES"
    title="Building Stronger Communities Through Seva, Education & Empowerment"
    description="Inspired by the philosophy of Vasudhaiv Kutumbukam, Sanatan Dharam Sewa Kendra works to create opportunities through education, skills, community development and social empowerment."
    image="/images/hero-community.webp"
    imageAlt="Illustrative Indian community learning gathering"
    primaryLabel="Explore Our Work"
    primaryHref="/programs"
    secondaryLabel="Support Our Mission"
    secondaryHref="/donate"
    trustLine="Education • Skills • Women Empowerment • Community Development"
  />

  <section class="section story-section" id="our-story">
    <div class="container story-grid">
      <div class="story-collage reveal" aria-label="Illustrative views of education, skills and community service">
        <div class="image-frame story-main"><img src="/images/community-outreach.webp" alt="Illustrative community outreach gathering" width="820" height="980" loading="lazy" /></div>
        <div class="image-frame story-small"><img src="/images/vocational-training.webp" alt="Illustrative vocational skills session" width="520" height="420" loading="lazy" /></div>
        <span class="story-seal"><strong>Since</strong> 2020</span>
      </div>
      <div class="story-copy reveal">
        <span class="eyebrow">Our beginning</span>
        <h2>Seva With Purpose.<br />Development With Responsibility.</h2>
        <p>Sanatan Dharam Sewa Kendra began its journey in 2020 with the aim of supporting students and economically disadvantaged communities through education and livelihood opportunities.</p>
        <p>The organisation works through professionals, teachers, instructors, social workers, community organisers and volunteers committed to meaningful community development.</p>
        <a class="text-link" href="/about">Discover Our Story <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <section class="section patron-section" aria-labelledby="patron-title">
    <div class="container">
      <article class="patron-panel reveal">
        <div class="patron-portrait">
          <span aria-hidden="true"></span>
          <img src="/images/arun-kumar-sinha.jpg" alt="Portrait of Shri Arun Kumar Sinha" width="200" height="200" loading="lazy" />
        </div>
        <div class="patron-copy">
          <span class="patron-kicker">Leadership &amp; Guidance</span>
          <h2 id="patron-title">Patron, Mentor &amp; Trustee</h2>
          <h3>Shri Arun Kumar Sinha</h3>
          <p class="patron-service">Retired IAS Officer <span aria-hidden="true">·</span> 1983 Batch <span aria-hidden="true">·</span> Uttar Pradesh Cadre</p>
          <div class="patron-appointments">
            <span>Former Key Appointments</span>
            <ul>
              <li>Additional Chief Secretary, Government of Uttar Pradesh</li>
              <li>Chairman and Member, Uttar Pradesh Subordinate Services Selection Commission (UPSSSC)</li>
              <li>Independent Director, Hindustan Aeronautics Limited (HAL)</li>
            </ul>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="section philosophy-section" aria-labelledby="philosophy-title">
    <div class="philosophy-rings" aria-hidden="true"><span></span></div>
    <div class="container philosophy-inner reveal">
      <span class="philosophy-kicker">VASUDHAIV KUTUMBUKAM</span>
      <h2 id="philosophy-title">One World. One Family.<br />A Shared Responsibility.</h2>
      <p>Our work is guided by the belief that sustainable social development begins with education, opportunity, dignity, service and harmony.</p>
    </div>
  </section>

  <section class="section focus-section">
    <div class="container">
      <SectionHeading eyebrow="Where we serve" title="Connected Areas of Community Action" description="Each focus area responds to a different part of community life. Together, they create a more practical and human path to development." />
      <div class="focus-grid">
        {focusAreas.map((area, index) => <FeatureCard {...area} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section section--cream programs-section">
    <div class="container">
      <SectionHeading eyebrow="Our programs" title="Practical Work, Shaped Around Community Needs" description="From learning and skills to health, safety and environmental awareness, each programme is designed around useful, accessible participation." />
      <div class="program-list">
        {programs.map((program, index) => <ProgramCard program={program} reverse={index % 2 === 1} />)}
      </div>
    </div>
  </section>

  <section class="section impact-section section--forest">
    <div class="container">
      <SectionHeading eyebrow="Impact philosophy" title="Change Is More Than a Number" description="We focus on the qualities that help communities move forward—learning, confidence, opportunity, participation and responsible action." light align="center" />
      <StatsStrip items={impactPhilosophy} />
    </div>
  </section>

  <section class="section health-camp-section" aria-labelledby="health-camp-title">
    <div class="container">
      <div class="health-camp-heading">
        <SectionHeading
          eyebrow="Community health in action"
          title="Health Check-up Camp"
          titleId="health-camp-title"
          description="A glimpse of our health camp, where organisers, medical professionals and community members came together around accessible preventive care."
        />
        <a class="text-link health-camp-link" href="/gallery">Explore the Gallery <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
      <div class="health-camp-gallery" aria-label="Photographs from the health check-up camp">
        {healthCampPhotos.map((photo, index) => (
          <figure class:list={['health-camp-photo', { 'health-camp-photo--lead': index === 0, 'health-camp-photo--wide': index === 1 }]} data-event-photo="true">
            <img src={photo.image} alt={photo.alt} width="888" height="667" loading="lazy" />
            <figcaption>{photo.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section activities-section">
    <div class="container">
      <SectionHeading eyebrow="Activity framework" title="Learning in Motion" description="These illustrative themes show how future activity updates can be shared. Verified organisation photographs and dates can be added as they become available." />
      <div class="activity-grid">
        {activities.map((activity) => (
          <article class="activity-card reveal" data-illustrative="true">
            <div class="image-frame"><img src={activity.image} alt={activity.imageAlt} width="720" height="520" loading="lazy" /></div>
            <span>{activity.category} · Illustrative</span>
            <h3>{activity.title}</h3>
            <p>{activity.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--cream voices-section">
    <div class="container">
      <SectionHeading eyebrow="Voices, with consent" title="Stories Will Be Shared Responsibly" description="This section is ready for verified, approved stories. It intentionally contains no fictional names or testimonials." />
      <div class="voices-grid">
        {testimonialPlaceholders.map((item) => <TestimonialCard {...item} />)}
      </div>
    </div>
  </section>

  <CTASection
    eyebrow="Build with us"
    title="Together, We Can Create Meaningful Change."
    description="Your time, expertise, partnership or contribution can help strengthen educational and community-development initiatives."
    actions={[
      { label: 'Donate Now', href: '/donate', style: 'primary' },
      { label: 'Become a Volunteer', href: '/get-involved#volunteer', style: 'light' },
      { label: 'Partner With Us', href: '/get-involved#partner', style: 'secondary' },
    ]}
  />
</MainLayout>

<style>
  .story-grid { display: grid; grid-template-columns: minmax(0, 1.03fr) minmax(0, .97fr); align-items: center; gap: clamp(3rem, 8vw, 8rem); }
  .story-collage { position: relative; min-height: 620px; }
  .story-main { position: absolute; inset: 0 18% 7% 0; }
  .story-small { position: absolute; right: 0; bottom: 0; width: 48%; aspect-ratio: 1.08; border: 8px solid var(--cream); }
  .story-seal { position: absolute; right: 4%; top: 6%; display: grid; width: 104px; aspect-ratio: 1; place-items: center; border-radius: 50%; background: var(--saffron); color: var(--ink); font-family: 'Lora Variable', serif; font-size: 1.35rem; line-height: 1; text-align: center; box-shadow: var(--shadow-sm); animation: seal-breathe 4s ease-in-out infinite alternate; }
  .story-seal strong { display: block; font-family: 'Manrope Variable', sans-serif; font-size: .62rem; letter-spacing: .15em; text-transform: uppercase; }

  @keyframes seal-breathe {
    0% { transform: scale(1) translateY(0); }
    100% { transform: scale(1.04) translateY(-4px); }
  }
  .story-copy { display: grid; gap: 1.25rem; }
  .story-copy h2 { color: var(--maroon); }
  .story-copy p { color: var(--muted); }
  .patron-section { padding-top: 0; background: linear-gradient(180deg, var(--cream) 0%, var(--white) 100%); }
  .patron-panel { position: relative; display: grid; grid-template-columns: minmax(200px, .72fr) minmax(0, 1.65fr); align-items: center; gap: clamp(2rem, 6vw, 5.5rem); overflow: hidden; padding: clamp(2rem, 5vw, 4.5rem); border-radius: var(--radius-lg); background: linear-gradient(135deg, #071e36 0%, var(--maroon) 68%, #0d3859 100%); color: var(--white); box-shadow: var(--shadow-lg); }
  .patron-panel::after { position: absolute; right: -8rem; bottom: -11rem; width: 24rem; aspect-ratio: 1; border: 1px solid rgba(255, 183, 3, .18); border-radius: 50%; box-shadow: 0 0 0 4rem rgba(255, 183, 3, .025), 0 0 0 8rem rgba(255, 183, 3, .018); content: ''; pointer-events: none; }
  .patron-portrait { position: relative; z-index: 1; width: min(100%, 250px); justify-self: center; padding: .7rem; border: 1px solid rgba(255, 255, 255, .2); border-radius: 28px; background: rgba(255, 255, 255, .08); box-shadow: 0 24px 55px rgba(0, 0, 0, .24); }
  .patron-portrait::before { position: absolute; z-index: -1; inset: -1.1rem auto auto -1.1rem; width: 4.2rem; height: 4.2rem; border-top: 3px solid var(--saffron); border-left: 3px solid var(--saffron); border-radius: 16px 0 0; content: ''; }
  .patron-portrait > span { position: absolute; z-index: 1; right: -.55rem; bottom: 1.3rem; width: .7rem; height: 4.5rem; border-radius: 999px; background: var(--gold); box-shadow: 0 0 0 6px rgba(255, 183, 3, .12); }
  .patron-portrait img { width: 100%; aspect-ratio: 1; border-radius: 20px; object-fit: cover; }
  .patron-copy { position: relative; z-index: 1; display: grid; min-width: 0; gap: .85rem; }
  .patron-kicker { color: #fde047; font-size: .7rem; font-weight: 850; letter-spacing: .18em; text-transform: uppercase; }
  .patron-copy h2 { max-width: 760px; color: var(--white); font-size: clamp(2rem, 4vw, 3.35rem); }
  .patron-copy h3 { margin-top: .45rem; color: #ffd0aa; font-family: 'Manrope Variable', sans-serif; font-size: clamp(1.15rem, 2vw, 1.45rem); font-weight: 800; }
  .patron-service { color: rgba(255, 255, 255, .76); font-size: .9rem; font-weight: 650; }
  .patron-service span { margin-inline: .35rem; color: var(--saffron); }
  .patron-appointments { display: grid; gap: .85rem; margin-top: 1.1rem; padding-top: 1.25rem; border-top: 1px solid rgba(255, 255, 255, .16); }
  .patron-appointments > span { color: rgba(255, 255, 255, .6); font-size: .66rem; font-weight: 850; letter-spacing: .15em; text-transform: uppercase; }
  .patron-appointments ul { display: grid; gap: .65rem; margin: 0; padding: 0; list-style: none; }
  .patron-appointments li { display: grid; grid-template-columns: .5rem 1fr; gap: .7rem; color: rgba(255, 255, 255, .88); font-size: .86rem; line-height: 1.55; }
  .patron-appointments li::before { width: .4rem; height: .4rem; margin-top: .55rem; border-radius: 50%; background: var(--saffron); content: ''; }
  .philosophy-section {
    display: grid;
    min-height: 640px;
    overflow: hidden;
    isolation: isolate;
    background: var(--cream-2);
  }
  .philosophy-inner {
    position: relative;
    z-index: 2;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
  }
  .philosophy-kicker {
    color: var(--saffron-dark);
    font-size: .72rem;
    font-weight: 850;
    letter-spacing: .24em;
  }
  .philosophy-inner h2 {
    max-width: 820px;
    margin-top: 1.35rem;
    color: var(--maroon);
    font-size: clamp(2.35rem, 4vw, 3.35rem);
    line-height: 1.08;
  }
  .philosophy-inner p {
    max-width: 680px;
    margin-top: 1.45rem;
    color: var(--muted);
    font-size: 1.06rem;
    line-height: 1.75;
  }
  .philosophy-rings {
    position: absolute;
    z-index: 0;
    left: 50%;
    top: 50%;
    width: min(54vw, 720px);
    aspect-ratio: 1;
    border: 1px solid rgba(10, 37, 64, .12);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    animation: rings-float 16s ease-in-out infinite alternate;
  }

  @keyframes rings-float {
    0% { transform: translate(-50%, -50%) rotate(0deg); }
    100% { transform: translate(-50%, -50%) scale(1.03) rotate(3deg); }
  }
  .philosophy-rings::before,
  .philosophy-rings::after,
  .philosophy-rings span {
    position: absolute;
    border-radius: 50%;
    content: '';
  }
  .philosophy-rings::before {
    inset: -4.25rem;
    border: 4.25rem solid rgba(10, 37, 64, .026);
  }
  .philosophy-rings::after {
    inset: -9rem;
    border: 4.75rem solid rgba(10, 37, 64, .018);
  }
  .philosophy-rings span {
    inset: 34%;
    border: 1px solid rgba(255, 107, 0, .35);
  }
  .focus-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 3rem; }
  .program-list { display: grid; gap: clamp(5rem, 10vw, 10rem); margin-top: clamp(4rem, 8vw, 7rem); }
  .impact-section :global(.section-heading) { margin-bottom: 3rem; }
  .health-camp-section { overflow: hidden; background: var(--white); }
  .health-camp-heading { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 2rem; }
  .health-camp-heading :global(.section-heading) { min-width: 0; max-width: 900px; }
  .health-camp-heading :global(.section-subtitle) { white-space: normal; }
  .health-camp-link { margin-bottom: .3rem; white-space: nowrap; }
  .health-camp-gallery { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(130px, 15vw, 190px); gap: .75rem; margin-top: 3rem; }
  .health-camp-photo { position: relative; overflow: hidden; min-width: 0; margin: 0; border-radius: var(--radius-sm); background: var(--cream-2); box-shadow: var(--shadow-sm); }
  .health-camp-photo--lead { grid-column: span 2; grid-row: span 2; border-radius: var(--radius-md); }
  .health-camp-photo--wide { grid-column: span 2; }
  .health-camp-photo::after { position: absolute; inset: 38% 0 0; background: linear-gradient(transparent, rgba(7, 30, 54, .72)); content: ''; pointer-events: none; }
  .health-camp-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 650ms cubic-bezier(.16, 1, .3, 1); }
  .health-camp-photo:hover img { transform: scale(1.035); }
  .health-camp-photo figcaption { position: absolute; z-index: 1; right: .9rem; bottom: .75rem; left: .9rem; color: white; font-size: .68rem; font-weight: 750; letter-spacing: .04em; line-height: 1.35; text-shadow: 0 1px 10px rgba(0, 0, 0, .28); }
  .health-camp-photo--lead figcaption { right: 1.25rem; bottom: 1.1rem; left: 1.25rem; font-size: .82rem; }
  .activity-grid, .voices-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 3rem; }
  .activity-card { display: grid; gap: .8rem; transition: transform 260ms cubic-bezier(0.16, 1, 0.3, 1); }
  .activity-card:hover { transform: translateY(-4px); }
  .activity-card .image-frame { aspect-ratio: 1.25; margin-bottom: .3rem; }
  .activity-card > span { color: var(--saffron-dark); font-size: .66rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .activity-card h3 { color: var(--maroon); transition: color 200ms ease; }
  .activity-card:hover h3 { color: var(--saffron-dark); }
  .activity-card p { color: var(--muted); font-size: .9rem; }
  @media (max-width: 900px) {
    .story-grid { grid-template-columns: 1fr; }
    .story-collage { min-height: 560px; }
    .patron-panel { grid-template-columns: minmax(170px, .62fr) minmax(0, 1.38fr); gap: 2rem; }
    .focus-grid, .activity-grid { grid-template-columns: repeat(2, 1fr); }
    .health-camp-heading { grid-template-columns: 1fr; gap: 1rem; }
    .health-camp-link { justify-self: start; }
    .health-camp-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: clamp(150px, 30vw, 230px); }
    .voices-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 580px) {
    .story-collage { min-height: 430px; }
    .story-main { right: 10%; }
    .story-small { width: 52%; }
    .story-seal { right: 1%; width: 84px; font-size: 1.1rem; }
    .patron-panel { grid-template-columns: 1fr; padding: 2rem 1.35rem; border-radius: var(--radius-md); text-align: center; }
    .patron-portrait { width: 180px; }
    .patron-copy { justify-items: center; }
    .patron-service { line-height: 1.7; }
    .patron-appointments { width: 100%; text-align: left; }
    .philosophy-section { min-height: 540px; }
    .philosophy-rings { width: 92vw; }
    .philosophy-rings::before { inset: -2.5rem; border-width: 2.5rem; }
    .philosophy-rings::after { inset: -5.5rem; border-width: 3rem; }
    .philosophy-inner h2 { font-size: clamp(2.1rem, 10vw, 2.8rem); }
    .philosophy-inner p { font-size: 1rem; }
    .health-camp-gallery { grid-template-columns: 1fr; grid-auto-rows: auto; gap: .65rem; margin-top: 2rem; }
    .health-camp-photo, .health-camp-photo--lead, .health-camp-photo--wide { grid-column: auto; grid-row: auto; aspect-ratio: 4 / 3; }
    .health-camp-photo figcaption, .health-camp-photo--lead figcaption { right: 1rem; bottom: .85rem; left: 1rem; font-size: .72rem; }
    .focus-grid, .activity-grid { grid-template-columns: 1fr; }
  }
</style>
