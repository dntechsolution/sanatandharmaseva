---
import { CircleCheckBig, Eye, HandHeart } from '@lucide/astro';
import CTASection from '../components/CTASection.astro';
import FeatureCard from '../components/FeatureCard.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { organisation } from '../data/organisation';
import MainLayout from '../layouts/MainLayout.astro';

const workCycle = [
  { title: 'Listen', description: 'Understand local priorities through dialogue and community connection.' },
  { title: 'Design', description: 'Shape practical initiatives around education, skills and awareness.' },
  { title: 'Participate', description: 'Bring together teachers, social workers, organisers and volunteers.' },
  { title: 'Learn', description: 'Reflect responsibly and strengthen future community action.' },
];
---

<MainLayout
  title="About Sanatan Dharam Sewa Kendra | Our Story & Values"
  description="Learn about Sanatan Dharam Sewa Kendra, its vision, mission, values and responsible approach to education and community development."
  canonicalPath="/about"
>
  <PageHero eyebrow="About us" title="Serving Society. Strengthening Communities." description="A community-focused journey guided by seva, learning, opportunity and shared responsibility." current="About Us" tone="maroon" />

  <section class="section">
    <div class="container story-grid">
      <div class="story-copy reveal">
        <span class="eyebrow">Our story</span>
        <h2>A Purpose That Began With Education</h2>
        <p>Sanatan Dharam Sewa Kendra began its journey in 2020 with the aim of supporting students and economically disadvantaged communities through education and livelihood opportunities.</p>
        <p>The organisation’s approach brings together professionals, teachers, instructors, social workers, community organisers and volunteers around meaningful, practical community development.</p>
      </div>
      <div class="image-frame story-image reveal">
        <img src="/images/community-outreach.webp" alt="Illustrative North Indian community outreach gathering" width="900" height="720" loading="lazy" />
        <span>Representative editorial image</span>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container purpose-grid">
      <article class="purpose-card card reveal">
        <Eye size={28} stroke-width={1.5} aria-hidden="true" />
        <span>Our vision</span><h2>Possibility With Dignity</h2><p>{organisation.vision}</p>
      </article>
      <article class="purpose-card purpose-card--green reveal">
        <HandHeart size={28} stroke-width={1.5} aria-hidden="true" />
        <span>Our mission</span><h2>Service That Enables</h2><p>{organisation.mission}</p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="What guides us" title="Values Practised Through Action" description="The organisation’s values are not decorative statements. They are the standards that shape how community work should be approached." />
      <div class="value-grid">
        {organisation.values.map((value, index) => <FeatureCard title={value.title} description={value.description} icon={index === 0 ? 'HeartHandshake' : index === 2 ? 'BookOpen' : index === 3 ? 'Users' : 'Leaf'} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section philosophy-band section--forest">
    <div class="container philosophy-grid">
      <div class="reveal"><span class="eyebrow">Our philosophy</span><h2>Vasudhaiv Kutumbukam</h2></div>
      <p class="reveal">One world. One family. A shared responsibility. This belief calls for education, opportunity, dignity, service and harmony to move together.</p>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <SectionHeading eyebrow="How we work" title="A Responsible Cycle of Community Action" description="Every initiative begins with understanding and grows through participation—not assumptions." />
      <div class="cycle-grid">
        {workCycle.map((item, index) => (
          <article class="cycle-card reveal">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <CircleCheckBig size={24} aria-hidden="true" />
            <h3>{item.title}</h3><p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section journey-section" aria-labelledby="journey-title">
    <div class="container journey-shell">
      <SectionHeading eyebrow="Organisation journey" title="A Young Journey, Built With Care" description="Only verified milestones are shown. Future developments can be added as they are formally documented." align="center" titleId="journey-title" />
      <ol class="timeline">
        <li class="timeline-card reveal"><span class="timeline-year">2020</span><div><span class="timeline-step" aria-hidden="true">01</span><h3>Community work begins</h3><p>The journey starts with an aim to support students and economically disadvantaged communities through education and livelihood opportunities.</p></div></li>
        <li class="timeline-card reveal"><span class="timeline-year">2022</span><div><span class="timeline-step" aria-hidden="true">02</span><h3>Trust registration</h3><p>Sanatan Dharam Sewa Kendra is registered on 31 August 2022 under registration number 534/2022–2023.</p></div></li>
      </ol>
    </div>
  </section>

  <CTASection eyebrow="Continue the journey" title="Service Becomes Stronger When People Participate." description="Explore the programmes, share your skills or start a conversation about responsible collaboration." actions={[{ label: 'Explore Programs', href: '/programs', style: 'light' }, { label: 'Get Involved', href: '/get-involved', style: 'secondary' }, { label: 'Contact Us', href: '/contact', style: 'primary' }]} />
</MainLayout>

<style>
  .story-grid { display: grid; grid-template-columns: .85fr 1.15fr; align-items: center; gap: clamp(2.5rem, 8vw, 8rem); }
  .story-copy { display: grid; gap: 1.2rem; }
  .story-copy h2 { color: var(--maroon); }
  .story-copy p { color: var(--muted); }
  .story-image { position: relative; aspect-ratio: 1.25; }
  .story-image span { position: absolute; right: 1rem; bottom: 1rem; padding: .42rem .65rem; border-radius: 999px; background: rgba(255,253,247,.9); color: var(--muted); font-size: .62rem; font-weight: 800; }
  .purpose-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .purpose-card { display: grid; min-height: 360px; align-content: end; gap: 1rem; padding: clamp(1.5rem, 4vw, 3rem); }
  .purpose-card svg, .purpose-card > span { color: var(--saffron-dark); }
  .purpose-card > span { font-size: .72rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .purpose-card h2 { color: var(--maroon); }
  .purpose-card p { color: var(--muted); }
  .purpose-card--green { border-radius: var(--radius-md); background: var(--forest); color: white; }
  .purpose-card--green h2, .purpose-card--green p, .purpose-card--green svg, .purpose-card--green > span { color: inherit; }
  .purpose-card--green p { opacity: .76; }
  .value-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 3rem; }
  .philosophy-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: 4rem; }
  .philosophy-grid h2 { margin-top: 1rem; color: white; }
  .philosophy-grid > p { color: rgba(255,255,255,.75); font-size: 1.16rem; }
  .cycle-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; margin-top: 3rem; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius-md); overflow: hidden; }
  .cycle-card { display: grid; min-height: 290px; align-content: start; gap: 1rem; padding: 1.5rem; background: var(--cream); }
  .cycle-card > span { color: var(--saffron); font-size: .7rem; font-weight: 800; }
  .cycle-card svg { color: var(--forest); }
  .cycle-card p { color: var(--muted); font-size: .9rem; }
  .journey-section { background: linear-gradient(180deg, var(--cream) 0%, #f7efe4 100%); }
  .journey-shell { display: grid; gap: clamp(3rem, 6vw, 5rem); }
  .timeline { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.25rem, 3vw, 2.5rem); max-width: 1000px; margin: 0 auto; padding: 0; list-style: none; }
  .timeline::before { position: absolute; top: 2rem; left: 25%; right: 25%; height: 1px; background: linear-gradient(90deg, var(--saffron), var(--maroon)); content: ''; }
  .timeline-card { position: relative; z-index: 1; display: grid; justify-items: center; gap: 1.25rem; text-align: center; }
  .timeline-year { display: grid; place-items: center; min-width: 92px; min-height: 64px; padding: .7rem 1.2rem; border: 1px solid rgba(156,66,15,.2); border-radius: 999px; background: var(--cream); color: var(--saffron-dark); font-family: 'Lora Variable', serif; font-size: 1.55rem; font-weight: 600; box-shadow: 0 8px 24px rgba(75,30,26,.08); }
  .timeline-card > div { position: relative; width: 100%; min-height: 230px; padding: clamp(1.5rem, 3vw, 2.25rem); border: 1px solid var(--line); border-radius: var(--radius-md); background: rgba(255,253,247,.86); box-shadow: var(--shadow-sm); }
  .timeline-step { display: block; margin-bottom: 1.4rem; color: var(--forest); font-size: .7rem; font-weight: 800; letter-spacing: .16em; }
  .timeline-card h3 { color: var(--maroon); font-size: clamp(1.3rem, 2vw, 1.65rem); }
  .timeline-card p { max-width: 46ch; margin: .8rem auto 0; color: var(--muted); font-size: .92rem; }
  @media (max-width: 850px) { .story-grid, .philosophy-grid { grid-template-columns: 1fr; } .purpose-grid, .value-grid { grid-template-columns: repeat(2, 1fr); } .cycle-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 650px) {
    .timeline { grid-template-columns: 1fr; gap: 2rem; }
    .timeline::before { top: 2rem; bottom: 2rem; left: 50%; right: auto; width: 1px; height: auto; background: linear-gradient(180deg, var(--saffron), var(--maroon)); }
    .timeline-card > div { min-height: auto; }
  }
  @media (max-width: 560px) { .purpose-grid, .value-grid, .cycle-grid { grid-template-columns: 1fr; } }
</style>
