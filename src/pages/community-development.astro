---
import { Baby, CircleDollarSign, Droplets, HeartHandshake, HeartPulse, Leaf, Megaphone, Salad, ShieldCheck, Sparkles, TrafficCone, Users } from '@lucide/astro';
import CTASection from '../components/CTASection.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MainLayout from '../layouts/MainLayout.astro';

const themes = [
  { id: 'women', title: 'Women Empowerment', description: 'Learning, skills, savings awareness and supportive participation.', icon: HeartHandshake },
  { id: 'mother-child', title: 'Mother & Child Care', description: 'Accessible conversations around parenting, nutrition and everyday care.', icon: Baby },
  { id: 'health', title: 'Health Awareness', description: 'Practical awareness for seasonal health, clean water and family well-being.', icon: HeartPulse },
  { id: 'environment', title: 'Environmental Awareness', description: 'Shared habits and community responsibility for cleaner surroundings.', icon: Leaf },
  { id: 'road-safety', title: 'Road Safety', description: 'Essential information that encourages careful and responsible travel.', icon: TrafficCone },
  { id: 'outreach', title: 'Community Outreach', description: 'Local dialogue that connects people, volunteers and useful information.', icon: Users },
];
const awarenessTopics = [
  { title: 'Nutrition', icon: Salad },
  { title: 'Seasonal diseases', icon: ShieldCheck },
  { title: 'Clean drinking water', icon: Droplets },
  { title: 'ORS awareness', icon: HeartPulse },
  { title: 'Parenting', icon: Baby },
  { title: 'Savings awareness', icon: CircleDollarSign },
  { title: 'Community responsibility', icon: Megaphone },
];
---

<MainLayout title="Community Development | Sanatan Dharam Sewa Kendra" description="Women empowerment, family welfare, health, environmental and road-safety awareness initiatives from Sanatan Dharam Sewa Kendra." canonicalPath="/community-development">
  <PageHero eyebrow="Community development" title="Strong Families. Empowered Women. Resilient Communities." description="Community development connects everyday knowledge, practical support and shared responsibility across families and neighbourhoods." current="Community Development" tone="maroon" />

  <section class="section">
    <div class="container intro-grid">
      <div class="image-frame reveal"><img src="/images/community-outreach.webp" alt="Illustrative multigenerational community outreach gathering" width="920" height="720" loading="lazy" /></div>
      <div class="reveal intro-copy"><span class="eyebrow">Community first</span><h2>Listening Is Where Meaningful Work Begins</h2><p>Community needs are connected. Health awareness can strengthen families; skills can build confidence; safer habits can improve shared spaces. The approach is therefore collaborative, practical and grounded in everyday life.</p><span class="image-note">Representative editorial image</span></div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <SectionHeading eyebrow="Areas of action" title="Connected Themes for Stronger Communities" description="Each theme supports a part of daily life while contributing to a broader culture of awareness and participation." />
      <div class="theme-grid">
        {themes.map(({ icon: Icon, ...theme }, index) => (
          <article class="theme-card card reveal" id={theme.id}>
            <span>{String(index + 1).padStart(2,'0')}</span><Icon size={28} stroke-width={1.55} aria-hidden="true" /><h2>{theme.title}</h2><p>{theme.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section awareness-section">
    <div class="container awareness-grid" data-layout-safe="true" data-heading-wrap="local">
      <div>
        <SectionHeading eyebrow="Awareness topics" title="Useful Knowledge for Everyday Decisions" description="Clear, approachable information can help families discuss health, safety, savings and shared responsibility with more confidence." />
        <Sparkles class="awareness-mark" size={68} stroke-width={1} aria-hidden="true" />
      </div>
      <div class="topic-grid">
        {awarenessTopics.map(({ title, icon: Icon }) => <article class="topic-card reveal"><Icon size={21} aria-hidden="true" /><h3>{title}</h3></article>)}
      </div>
    </div>
  </section>

  <CTASection eyebrow="Work locally" title="Community Change Grows Through Shared Effort." description="Share expertise, help with outreach or explore a responsible institutional partnership." actions={[{ label: 'Volunteer', href: '/get-involved#volunteer', style: 'light' }, { label: 'Partner With Us', href: '/get-involved#partner', style: 'secondary' }, { label: 'Contact Us', href: '/contact', style: 'primary' }]} />
</MainLayout>

<style>
  .intro-grid { display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: clamp(2.5rem,8vw,8rem); }
  .intro-grid .image-frame { aspect-ratio: 1.25; }
  .intro-copy { display: grid; gap: 1.2rem; }
  .intro-copy h2 { color: var(--maroon); }
  .intro-copy p { color: var(--muted); }
  .image-note { color: var(--saffron-dark); font-size: .65rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .theme-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; margin-top: 3rem; }
  .theme-card { display: grid; min-height: 290px; align-content: start; gap: 1rem; padding: 1.5rem; scroll-margin-top: 100px; }
  .theme-card > span { color: var(--saffron); font-size: .7rem; font-weight: 800; }
  .theme-card svg { color: var(--forest); }
  .theme-card h2 { color: var(--maroon); font-size: 1.4rem; }
  .theme-card p { color: var(--muted); font-size: .9rem; }
  .awareness-grid { display: grid; grid-template-columns: minmax(0,.9fr) minmax(0,1.1fr); align-items: start; gap: clamp(2.5rem,6vw,6rem); }
  .awareness-grid > *, .topic-grid { min-width: 0; }
  .awareness-grid :global(.section-title), .awareness-grid :global(.section-subtitle) { max-width: 100%; white-space: normal; }
  .awareness-mark { margin-top: 2rem; color: var(--saffron); }
  .topic-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: .8rem; }
  .topic-card { display: flex; min-height: 120px; align-items: center; gap: 1rem; padding: 1.25rem; border: 1px solid var(--line); border-radius: 16px; background: white; }
  .topic-card svg { flex: 0 0 auto; color: var(--forest); }
  .topic-card h3 { color: var(--ink); font-family: 'Manrope Variable', sans-serif; font-size: .93rem; font-weight: 800; }
  @media (max-width: 820px) { .intro-grid, .awareness-grid { grid-template-columns: 1fr; } .theme-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 540px) { .theme-grid, .topic-grid { grid-template-columns: 1fr; } }
</style>
