---
import { X } from '@lucide/astro';
import GalleryCard from '../components/GalleryCard.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { galleryCategories, galleryItems } from '../data/gallery';
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Gallery | Sanatan Dharam Sewa Kendra" description="Explore representative editorial imagery for education, skills, community, health, environment and women-empowerment initiatives." canonicalPath="/gallery">
  <PageHero eyebrow="Gallery" title="A Visual Language for Community Action" description="Illustrative images stay labelled until verified organisation photographs become available." descriptionSize="compact" current="Gallery" tone="green" />
  <section class="section gallery-section">
    <div class="container">
      <SectionHeading eyebrow="Illustrative gallery" title="Learning, Skills and Community" description="Use the filters to explore themes. Every image below is representative and can later be replaced with an approved organisation photograph." />
      <div class="gallery-tools">
        <div class="gallery-filters" aria-label="Filter gallery">
          {galleryCategories.map((category, index) => <button type="button" data-gallery-filter={category} aria-pressed={index === 0 ? 'true' : 'false'}>{category}</button>)}
        </div>
        <p aria-live="polite" data-gallery-count>{galleryItems.length} illustrative images</p>
      </div>
      <div class="gallery-grid" data-gallery-grid>
        {galleryItems.map((item, index) => <GalleryCard item={item} index={index} />)}
      </div>
    </div>
  </section>

  <dialog class="lightbox" aria-labelledby="lightbox-title" data-lightbox>
    <button class="lightbox-close" type="button" aria-label="Close larger image" data-lightbox-close><X size={22} aria-hidden="true" /></button>
    <img src="" alt="" width="1200" height="900" data-lightbox-image />
    <div><h2 id="lightbox-title" data-lightbox-title></h2><p data-lightbox-caption></p></div>
  </dialog>
</MainLayout>

<script>
  import { filterGallery } from '../scripts/gallery';
  import type { GalleryItem } from '../data/types';

  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-gallery-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-gallery-item]')];
  const count = document.querySelector<HTMLElement>('[data-gallery-count]');
  const records: GalleryItem[] = cards.map((card) => ({
    id: card.dataset.id ?? '',
    category: card.dataset.category as GalleryItem['category'],
    title: '', image: '', alt: '', caption: '', illustrative: true,
  }));

  filterButtons.forEach((button) => button.addEventListener('click', () => {
    const category = button.dataset.galleryFilter ?? 'All';
    const visible = new Set(filterGallery(records, category).map(({ id }) => id));
    filterButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    cards.forEach((card) => { card.hidden = !visible.has(card.dataset.id ?? ''); });
    if (count) count.textContent = `${visible.size} illustrative ${visible.size === 1 ? 'image' : 'images'}`;
  }));

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const dialogImage = dialog?.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const dialogTitle = dialog?.querySelector<HTMLElement>('[data-lightbox-title]');
  const dialogCaption = dialog?.querySelector<HTMLElement>('[data-lightbox-caption]');
  const close = dialog?.querySelector<HTMLButtonElement>('[data-lightbox-close]');
  let opener: HTMLButtonElement | null = null;

  document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]').forEach((button) => button.addEventListener('click', () => {
    opener = button;
    if (dialogImage) { dialogImage.src = button.dataset.src ?? ''; dialogImage.alt = button.dataset.title ?? ''; }
    if (dialogTitle) dialogTitle.textContent = button.dataset.title ?? '';
    if (dialogCaption) dialogCaption.textContent = button.dataset.caption ?? '';
    dialog?.showModal();
  }));
  close?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  dialog?.addEventListener('close', () => opener?.focus());
</script>

<style>
  .gallery-tools { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin: 2.5rem 0 2rem; }
  .gallery-filters { display: flex; flex-wrap: wrap; gap: .5rem; }
  .gallery-filters button { min-height: 42px; padding: .55rem .85rem; border: 1px solid var(--line); border-radius: 999px; background: white; color: var(--muted); font-size: .72rem; font-weight: 800; cursor: pointer; transition: transform 180ms ease, background-color 180ms ease, color 180ms ease, border-color 180ms ease, box-shadow 180ms ease; }
  .gallery-filters button:hover:not([aria-pressed='true']) { background: color-mix(in srgb, var(--forest) 8%, white); border-color: var(--forest); transform: translateY(-1px); }
  .gallery-filters button:active { transform: scale(0.96); }
  .gallery-filters button[aria-pressed='true'] { border-color: var(--forest); background: var(--forest); color: white; box-shadow: 0 4px 14px rgba(41, 93, 71, 0.2); }
  .gallery-tools > p { flex: 0 0 auto; color: var(--muted); font-size: .72rem; }
  .gallery-grid { columns: 3 290px; column-gap: 1rem; }
  .lightbox { width: min(92vw,1000px); max-height: 90vh; overflow: auto; padding: 0; border: 0; border-radius: var(--radius-md); background: var(--cream); color: var(--ink); box-shadow: var(--shadow-lg); }
  .lightbox::backdrop { background: rgba(17,30,24,.78); backdrop-filter: blur(8px); }
  .lightbox img { width: 100%; max-height: 70vh; object-fit: contain; background: #131c17; }
  .lightbox > div { padding: 1.2rem 1.5rem 1.5rem; }
  .lightbox h2 { color: var(--maroon); font-size: 1.5rem; }
  .lightbox p { margin-top: .5rem; color: var(--muted); font-size: .86rem; }
  .lightbox-close { position: absolute; z-index: 2; top: .8rem; right: .8rem; display: grid; width: 44px; height: 44px; place-items: center; border: 0; border-radius: 50%; background: rgba(255,255,255,.92); color: var(--ink); cursor: pointer; }
  @media (max-width: 700px) { .gallery-tools { align-items: flex-start; flex-direction: column; } .gallery-grid { columns: 2 150px; } }
  @media (max-width: 430px) { .gallery-grid { columns: 1; } }
</style>
