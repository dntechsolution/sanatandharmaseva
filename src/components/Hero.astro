---
import { ArrowRight } from '@lucide/astro';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel: string;
  secondaryHref: string;
  trustLine?: string;
}

const props = Astro.props;
---

<section class="hero">
  <img class="hero-image" src={props.image} alt={props.imageAlt} width="1920" height="1080" fetchpriority="high" />
  <div class="hero-wash" aria-hidden="true"></div>
  <div class="container hero-content">
    <span class="hero-eyebrow">{props.eyebrow}</span>
    <h1>{props.title}</h1>
    <p>{props.description}</p>
    <div class="hero-actions">
      <a class="button button--primary" href={props.primaryHref}>{props.primaryLabel}<ArrowRight class="button-arrow" size={18} aria-hidden="true" /></a>
      <a class="button button--secondary" href={props.secondaryHref}>{props.secondaryLabel}</a>
    </div>
    {props.trustLine && <div class="trust-line">{props.trustLine}</div>}
  </div>
</section>

<style>
  .hero { position: relative; display: grid; min-height: min(880px, 96svh); align-items: end; overflow: hidden; background: var(--forest-dark); color: white; }
  .hero-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 58% center; }
  .hero-wash { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(7, 30, 54, .97) 0%, rgba(7, 30, 54, .85) 38%, rgba(7, 30, 54, .35) 70%, rgba(7, 30, 54, .45) 100%), linear-gradient(0deg, rgba(7, 30, 54, .65), transparent 50%); }
  .hero-content { position: relative; z-index: 2; display: grid; max-width: 1180px; gap: 1.35rem; padding-top: calc(var(--header-height) + 5rem); padding-bottom: clamp(5.5rem, 9vw, 8.5rem); }
  .hero-eyebrow { width: fit-content; padding: .48rem .75rem; border: 1px solid rgba(255,255,255,.24); border-radius: 999px; background: rgba(255,255,255,.1); color: #fde047; font-size: .68rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; backdrop-filter: blur(8px); }
  h1 { max-width: 880px; }
  p { max-width: 700px; color: rgba(255,255,255,.86); font-size: clamp(1.02rem, 1.7vw, 1.25rem); line-height: 1.75; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: .6rem; }
  .trust-line { margin-top: .5rem; color: rgba(255,255,255,.75); font-size: .7rem; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
  @media (max-width: 640px) {
    .hero { min-height: 790px; }
    .hero-image { object-position: 65% center; }
    .hero-wash { background: linear-gradient(0deg, rgba(7,30,54,.98) 0%, rgba(7,30,54,.82) 62%, rgba(7,30,54,.4) 100%); }
    .hero-content { padding-bottom: 6rem; }
    .hero-actions { display: grid; }
    .trust-line { line-height: 1.7; }
  }

  @media (max-width: 430px) {
    .hero { min-height: 740px; }
    .hero-content { padding-top: calc(var(--header-height) + 3.5rem); padding-bottom: 5rem; gap: 1.1rem; }
    h1 { max-width: 100%; font-size: clamp(2rem, 9vw, 2.5rem); }
    p { font-size: clamp(.95rem, 3.4vw, 1.08rem); }
    .hero-eyebrow { font-size: .6rem; padding: .36rem .6rem; }
  }
</style>
