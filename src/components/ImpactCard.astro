---
interface Props { title: string; description: string; index: number }
const { title, description, index } = Astro.props;
---
<article class="impact-card reveal">
  <span>{String(index + 1).padStart(2, '0')}</span>
  <h3>{title}</h3>
  <p>{description}</p>
</article>
<style>
  .impact-card { padding: 1.5rem 1.2rem; border-left: 1px solid rgba(255,255,255,.16); }
  span { color: #f5a05f; font-size: .66rem; font-weight: 800; letter-spacing: .12em; }
  h3 { margin-top: 2.4rem; color: white; }
  p { margin-top: .7rem; color: rgba(255,255,255,.66); font-size: .88rem; }
  @media (max-width: 700px) { .impact-card { border-left: 0; border-top: 1px solid rgba(255,255,255,.16); } h3 { margin-top: 1.2rem; } }
</style>
