---
import { MessageCircle, Phone } from '@lucide/astro';
import { organisation } from '../data/organisation';
---

<aside class="floating-contact" aria-label="Quick contact">
  <a class="float-action float-action--call" href={organisation.phoneHref} aria-label="Call us">
    <Phone size={21} aria-hidden="true" />
    <span>Call Us</span>
  </a>
  <a
    class="float-action float-action--whatsapp"
    href={organisation.whatsappHref}
    target="_blank"
    rel="noreferrer"
    aria-label="Chat on WhatsApp"
  >
    <MessageCircle size={22} aria-hidden="true" />
    <span>Chat on WhatsApp</span>
  </a>
</aside>

<style>
  .floating-contact {
    position: fixed;
    z-index: 90;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: grid;
    gap: 0.75rem;
  }

  .float-action {
    position: relative;
    display: grid;
    width: 50px;
    height: 50px;
    place-items: center;
    border: 2px solid rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    color: var(--white);
    box-shadow: 0 10px 24px rgba(28, 35, 30, 0.22);
    opacity: 0;
    transform: translateY(12px);
    animation: float-enter 500ms 700ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 220ms ease;
  }

  .float-action:hover,
  .float-action:focus-visible {
    transform: scale(1.1) translateY(-2px);
    box-shadow: 0 16px 32px rgba(28, 35, 30, 0.3);
  }

  .float-action:active {
    transform: scale(0.96);
  }

  .float-action--call {
    background: var(--saffron);
  }

  .float-action--whatsapp {
    background: #238a55;
    animation: float-enter 500ms 820ms cubic-bezier(0.16, 1, 0.3, 1) forwards, pulse-glow 3.5s 1.5s infinite;
  }

  @keyframes pulse-glow {
    0%, 100% {
      box-shadow: 0 10px 24px rgba(35, 138, 85, 0.25);
    }
    50% {
      box-shadow: 0 12px 28px rgba(35, 138, 85, 0.45), 0 0 0 7px rgba(35, 138, 85, 0.16);
    }
  }

  .float-action span {
    position: absolute;
    right: calc(100% + 0.7rem);
    width: max-content;
    padding: 0.42rem 0.65rem;
    border-radius: 0.5rem;
    background: var(--ink);
    color: var(--white);
    font-size: 0.7rem;
    font-weight: 750;
    opacity: 0;
    pointer-events: none;
    transform: translateX(5px);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .float-action:hover span,
  .float-action:focus-visible span {
    opacity: 1;
    transform: none;
  }

  @keyframes float-enter {
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 640px) {
    .floating-contact {
      right: max(0.85rem, env(safe-area-inset-right));
      bottom: max(1rem, env(safe-area-inset-bottom));
      gap: 0.65rem;
    }

    .float-action {
      width: 46px;
      height: 46px;
    }

    .float-action span {
      display: none;
    }
  }
</style>
