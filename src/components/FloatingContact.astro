---
import { MessageCircle, Phone } from '@lucide/astro';
import { organisation } from '../data/organisation';
---

<aside class="floating-contact" aria-label="Quick contact">
  <a class="float-action float-action--call" href={organisation.phoneHref} aria-label="Call us">
    <Phone size={21} aria-hidden="true" />
    <span>Call Us</span>
  </a>
  <a
    class="float-action float-action--whatsapp"
    href={organisation.whatsappHref}
    target="_blank"
    rel="noreferrer"
    aria-label="Chat on WhatsApp"
  >
    <MessageCircle size={22} aria-hidden="true" />
    <span>Chat on WhatsApp</span>
  </a>
</aside>

<style>
  .floating-contact {
    position: fixed;
    z-index: 90;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: grid;
    gap: 0.75rem;
  }

  .float-action {
    position: relative;
    display: grid;
    width: 50px;
    height: 50px;
    place-items: center;
    border: 2px solid rgba(255, 255, 255, 0.8);
    border-radius: 50%;
    color: var(--white);
    box-shadow: 0 12px 26px rgba(28, 35, 30, 0.2);
    opacity: 0;
    transform: translateY(12px);
    animation: float-enter 500ms 700ms ease forwards;
  }

  .float-action--call {
    background: var(--saffron);
  }

  .float-action--whatsapp {
    background: #238a55;
    animation-delay: 820ms;
  }

  .float-action span {
    position: absolute;
    right: calc(100% + 0.7rem);
    width: max-content;
    padding: 0.42rem 0.65rem;
    border-radius: 0.5rem;
    background: var(--ink);
    color: var(--white);
    font-size: 0.7rem;
    font-weight: 750;
    opacity: 0;
    pointer-events: none;
    transform: translateX(5px);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .float-action:hover span,
  .float-action:focus-visible span {
    opacity: 1;
    transform: none;
  }

  @keyframes float-enter {
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 640px) {
    .floating-contact {
      right: max(0.35rem, env(safe-area-inset-right));
    }

    .float-action {
      width: 42px;
      height: 42px;
    }

    .float-action span {
      display: none;
    }
  }
</style>
