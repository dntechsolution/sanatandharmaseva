---
import { ArrowUpRight } from '@lucide/astro';
import type { Program } from '../data/types';

interface Props { program: Program; reverse?: boolean }
const { program, reverse = false } = Astro.props;
---

<article class:list={['program-story', { 'program-story--reverse': reverse }]} data-program-number={program.number}>
  <div class="image-frame program-image">
    <img src={program.image} alt={program.imageAlt} width="900" height="680" loading="lazy" />
    <span class="program-number" aria-hidden="true">{program.number}</span>
  </div>
  <div class="program-copy reveal">
    <span class="eyebrow">Program {program.number}</span>
    <h3>{program.title}</h3>
    <p>{program.description}</p>
    <ul>
      {program.objectives.map((objective) => <li>{objective}</li>)}
    </ul>
    <a class="text-link" href={program.href}>Explore this area <ArrowUpRight size={18} aria-hidden="true" /></a>
  </div>
</article>

<style>
  .program-story { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); align-items: center; gap: clamp(2rem, 7vw, 7rem); }
  .program-story--reverse .program-image { order: 2; }
  .program-image { position: relative; aspect-ratio: 4 / 3; }
  .program-number { position: absolute; right: 1rem; bottom: 1rem; display: grid; width: 64px; height: 64px; place-items: center; border: 1px solid rgba(255,255,255,.6); border-radius: 50%; background: rgba(23,62,48,.83); color: white; font-family: 'Lora', serif; font-size: 1.3rem; backdrop-filter: blur(8px); }
  .program-copy { display: grid; gap: 1.1rem; }
  h3 { color: var(--maroon); font-size: clamp(2rem, 3.4vw, 3.1rem); }
  p { color: var(--muted); font-size: 1.04rem; }
  ul { display: grid; gap: .55rem; margin: .3rem 0; padding: 0; list-style: none; }
  li { position: relative; padding-left: 1.3rem; color: var(--ink); font-size: .88rem; font-weight: 700; }
  li::before { position: absolute; left: 0; top: .67em; width: 6px; height: 6px; border-radius: 50%; background: var(--saffron); content: ''; }
  @media (max-width: 800px) { .program-story { grid-template-columns: 1fr; gap: 1.8rem; } .program-story--reverse .program-image { order: 0; } }
</style>
