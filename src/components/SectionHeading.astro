---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  light?: boolean;
  titleId?: string;
}

const { eyebrow, title, description, align = 'left', light = false, titleId } = Astro.props;
---

<header class:list={['section-heading', `section-heading--${align}`, { 'section-heading--light': light }]}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2 class="section-title" id={titleId}>{title}</h2>
  {description && <p class="section-subtitle">{description}</p>}
</header>

<style>
  .section-heading { display: grid; width: 100%; max-width: none; gap: 1rem; }
  .section-heading--center { margin-inline: auto; justify-items: center; text-align: center; }
  .section-title { max-width: none; color: var(--maroon); font-size: clamp(2rem, 3vw, 2.75rem); }
  .section-subtitle { max-width: none; color: var(--muted); font-size: clamp(.94rem, 1.15vw, 1.06rem); }
  .section-heading--light h2, .section-heading--light p { color: inherit; }
  .section-heading--light p { opacity: .74; }
  @media (min-width: 1280px) {
    .section-title,
    .section-subtitle { white-space: nowrap; }
  }
</style>
