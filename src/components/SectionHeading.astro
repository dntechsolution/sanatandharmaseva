---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  light?: boolean;
}

const { eyebrow, title, description, align = 'left', light = false } = Astro.props;
---

<header class:list={['section-heading', `section-heading--${align}`, { 'section-heading--light': light }]}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2>{title}</h2>
  {description && <p>{description}</p>}
</header>

<style>
  .section-heading { display: grid; max-width: 760px; gap: 1rem; }
  .section-heading--center { margin-inline: auto; justify-items: center; text-align: center; }
  h2 { color: var(--maroon); }
  p { max-width: 66ch; color: var(--muted); font-size: clamp(1rem, 1.4vw, 1.12rem); }
  .section-heading--light h2, .section-heading--light p { color: inherit; }
  .section-heading--light p { opacity: .74; }
</style>
