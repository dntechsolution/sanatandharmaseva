---
import { ChevronDown, Menu, X } from '@lucide/astro';
import { primaryNavigation, programNavigation } from '../data/navigation';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const leadingNavigation = primaryNavigation.slice(0, 2);
const trailingNavigation = primaryNavigation.slice(2);
const programsActive = programNavigation.some(({ href }) => href === currentPath);
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Sanatan Dharam Sewa Kendra — Home">
      <span class="brand-logo-frame" aria-hidden="true">
        <img
          class="brand-logo"
          src="/images/sanatan-dharma-sewa-kendra-logo.webp"
          alt="Sanatan Dharam Sewa Kendra logo"
          width="320"
          height="320"
          decoding="async"
          fetchpriority="high"
        />
      </span>
      <span class="brand-copy">
        <strong>Sanatan Dharam</strong>
        <small>Sewa Kendra</small>
      </span>
    </a>

    <nav class="desktop-navigation" aria-label="Primary navigation">
      <ul>
        {leadingNavigation.map((item) => (
          <li>
            <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        <li class="navigation-group">
          <details open={programsActive}>
            <summary class:list={{ 'is-current': programsActive }}>
              Programs <ChevronDown size={14} stroke-width={2} aria-hidden="true" />
            </summary>
            <ul class="navigation-submenu">
              {programNavigation.map((item) => (
                <li>
                  <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
        {trailingNavigation.map((item) => (
          <li>
            <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="header-donate" href="/donate">Donate now</a>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Open navigation"
      aria-controls="mobile-navigation"
      aria-expanded="false"
      data-menu-open
    >
      <Menu size={23} stroke-width={1.8} aria-hidden="true" />
    </button>
  </div>

  <div class="mobile-menu" id="mobile-navigation" aria-hidden="true" data-mobile-menu>
    <button class="menu-backdrop" type="button" tabindex="-1" aria-label="Close navigation" data-menu-close></button>
    <div class="mobile-panel" role="dialog" aria-modal="true" aria-label="Site navigation" data-drawer-panel>
      <div class="mobile-panel-head">
        <span class="eyebrow">Explore</span>
        <button class="menu-close" type="button" aria-label="Close navigation" data-menu-close>
          <X size={23} aria-hidden="true" />
        </button>
      </div>
      <nav aria-label="Mobile navigation">
        <ul>
          {leadingNavigation.map((item, index) => (
            <li>
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                <span>{String(index + 1).padStart(2, '0')}</span>{item.label}
              </a>
            </li>
          ))}
          <li class="mobile-navigation-group">
            <details open={programsActive}>
              <summary class:list={{ 'is-current': programsActive }}>
                <span>03</span>Programs <ChevronDown size={18} stroke-width={2} aria-hidden="true" />
              </summary>
              <ul>
                {programNavigation.map((item) => (
                  <li>
                    <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
          {trailingNavigation.map((item, index) => (
            <li>
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                <span>{String(index + 4).padStart(2, '0')}</span>{item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a class="button button--primary" href="/donate">Donate now</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    z-index: 100;
    inset: 0 0 auto;
    height: var(--header-height);
    color: var(--ink);
    transition: background-color 220ms ease, box-shadow 220ms ease, height 220ms ease;
  }

  .site-header::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: color-mix(in srgb, var(--cream) 80%, transparent);
    backdrop-filter: blur(16px);
    content: '';
    opacity: 0.94;
    transition: opacity 220ms ease;
  }

  .site-header.is-scrolled {
    box-shadow: 0 10px 30px rgba(36, 36, 36, 0.08);
  }

  .site-header.is-scrolled::before {
    background: color-mix(in srgb, var(--cream) 94%, transparent);
  }

  .header-inner {
    display: flex;
    height: 100%;
    align-items: center;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.7rem;
  }

  .brand-logo-frame {
    display: block;
    width: 52px;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--saffron) 48%, transparent);
    border-radius: 50%;
    background: #f6c255;
    box-shadow: 0 5px 14px rgba(76, 31, 28, 0.14);
  }

  .brand-logo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
  }

  .brand-copy {
    display: grid;
    line-height: 1.05;
  }

  .brand-copy strong {
    font-family: 'Lora Variable', Georgia, serif;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .brand-copy small {
    margin-top: 0.22rem;
    color: var(--maroon);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .desktop-navigation {
    margin-left: auto;
  }

  .desktop-navigation ul {
    display: flex;
    align-items: center;
    gap: clamp(0.65rem, 1.2vw, 1.2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-navigation a,
  .desktop-navigation summary {
    position: relative;
    display: block;
    padding-block: 0.8rem;
    font-size: 0.72rem;
    font-weight: 750;
    white-space: nowrap;
  }

  .desktop-navigation summary {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    cursor: pointer;
    list-style: none;
  }

  .desktop-navigation summary::-webkit-details-marker {
    display: none;
  }

  .desktop-navigation a::after,
  .desktop-navigation summary::after {
    position: absolute;
    inset: auto 50% 0.35rem;
    height: 2px;
    background: var(--saffron);
    content: '';
    transition: inset 180ms ease;
  }

  .desktop-navigation a:hover::after,
  .desktop-navigation a[aria-current='page']::after,
  .desktop-navigation summary:hover::after,
  .desktop-navigation summary.is-current::after {
    inset-inline: 0;
  }

  .navigation-group {
    position: relative;
  }

  .navigation-group details[open] summary svg {
    transform: rotate(180deg);
  }

  .navigation-group summary svg {
    transition: transform 180ms ease;
  }

  .desktop-navigation .navigation-submenu {
    position: absolute;
    z-index: 5;
    inset: calc(100% - 0.25rem) auto auto 50%;
    display: grid;
    width: max-content;
    min-width: 230px;
    gap: 0.2rem;
    padding: 0.55rem;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--cream);
    box-shadow: 0 18px 45px rgba(36, 36, 36, 0.14);
    transform: translateX(-50%);
  }

  .desktop-navigation .navigation-submenu a {
    padding: 0.7rem 0.85rem;
    border-radius: 10px;
    font-size: 0.7rem;
  }

  .desktop-navigation .navigation-submenu a:hover,
  .desktop-navigation .navigation-submenu a[aria-current='page'] {
    background: color-mix(in srgb, var(--saffron) 14%, transparent);
    color: var(--maroon);
  }

  .desktop-navigation .navigation-submenu a::after {
    display: none;
  }

  .header-donate {
    flex: 0 0 auto;
    padding: 0.8rem 1rem;
    border-radius: 999px;
    background: var(--saffron);
    color: var(--ink);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .menu-toggle,
  .menu-close {
    display: none;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--cream);
    color: var(--ink);
    cursor: pointer;
  }

  .mobile-menu {
    position: fixed;
    z-index: 120;
    inset: 0;
    visibility: hidden;
  }

  .menu-backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(24, 31, 27, 0.55);
    opacity: 0;
    backdrop-filter: blur(4px);
    transition: opacity 220ms ease;
  }

  .mobile-panel {
    position: absolute;
    inset: 0 0 0 auto;
    display: flex;
    width: min(90vw, 420px);
    max-height: 100dvh;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.25rem 1.25rem max(1.5rem, env(safe-area-inset-bottom));
    background: var(--cream);
    box-shadow: -30px 0 70px rgba(21, 41, 31, 0.18);
    transform: translateX(105%);
    transition: transform 260ms cubic-bezier(0.22, 0.72, 0.22, 1);
  }

  .mobile-menu.is-open {
    visibility: visible;
  }

  .mobile-menu.is-open .menu-backdrop {
    opacity: 1;
  }

  .mobile-menu.is-open .mobile-panel {
    transform: none;
  }

  .mobile-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .mobile-panel nav {
    margin-block: 1rem auto;
  }

  .mobile-panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-panel a:not(.button) {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.72rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 65%, transparent);
    font-family: 'Lora Variable', Georgia, serif;
    font-size: clamp(1.1rem, 4vw, 1.45rem);
    line-height: 1.2;
  }

  .mobile-panel a span {
    color: var(--saffron);
    font-family: 'Manrope Variable', sans-serif;
    font-size: 0.62rem;
    font-weight: 800;
  }

  .mobile-navigation-group summary {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.72rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 65%, transparent);
    font-family: 'Lora Variable', Georgia, serif;
    font-size: clamp(1.1rem, 4vw, 1.45rem);
    line-height: 1.2;
    cursor: pointer;
    list-style: none;
  }

  .mobile-navigation-group summary::-webkit-details-marker {
    display: none;
  }

  .mobile-navigation-group summary > span {
    color: var(--saffron);
    font-family: 'Manrope Variable', sans-serif;
    font-size: 0.62rem;
    font-weight: 800;
  }

  .mobile-navigation-group summary svg {
    margin-left: auto;
    transition: transform 180ms ease;
  }

  .mobile-navigation-group details[open] summary svg {
    transform: rotate(180deg);
  }

  .mobile-panel .mobile-navigation-group ul {
    padding: 0.35rem 0 0.45rem 2rem;
  }

  .mobile-panel .mobile-navigation-group a {
    padding-block: 0.6rem;
    font-family: 'Manrope Variable', sans-serif;
    font-size: 0.88rem;
    font-weight: 750;
  }

  @media (max-width: 1160px) {
    .desktop-navigation {
      display: none;
    }

    .menu-toggle,
    .menu-close {
      display: grid;
    }

    .menu-toggle {
      margin-left: auto;
    }
  }

  @media (max-width: 520px) {
    .header-donate {
      display: none;
    }

    .brand-copy strong {
      font-size: 0.86rem;
    }

    .brand-logo-frame {
      width: 46px;
    }
  }
</style>
