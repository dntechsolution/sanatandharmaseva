---
import { Menu, X } from '@lucide/astro';
import { primaryNavigation } from '../data/navigation';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Sanatan Dharam Sewa Kendra — Home">
      <span class="brand-mark" aria-hidden="true">
        <span></span>
      </span>
      <span class="brand-copy">
        <strong>Sanatan Dharam</strong>
        <small>Sewa Kendra</small>
      </span>
    </a>

    <nav class="desktop-navigation" aria-label="Primary navigation">
      <ul>
        {primaryNavigation.map((item) => (
          <li>
            <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="header-donate" href="/donate">Donate now</a>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Open navigation"
      aria-controls="mobile-navigation"
      aria-expanded="false"
      data-menu-open
    >
      <Menu size={23} stroke-width={1.8} aria-hidden="true" />
    </button>
  </div>

  <div class="mobile-menu" id="mobile-navigation" aria-hidden="true" data-mobile-menu>
    <button class="menu-backdrop" type="button" aria-label="Close navigation" data-menu-close></button>
    <div class="mobile-panel" role="dialog" aria-modal="true" aria-label="Site navigation">
      <div class="mobile-panel-head">
        <span class="eyebrow">Explore</span>
        <button class="menu-close" type="button" aria-label="Close navigation" data-menu-close>
          <X size={23} aria-hidden="true" />
        </button>
      </div>
      <nav aria-label="Mobile navigation">
        <ul>
          {primaryNavigation.map((item, index) => (
            <li>
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                <span>{String(index + 1).padStart(2, '0')}</span>{item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a class="button button--primary" href="/donate">Donate now</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    z-index: 100;
    inset: 0 0 auto;
    height: var(--header-height);
    color: var(--ink);
    transition: background-color 220ms ease, box-shadow 220ms ease, height 220ms ease;
  }

  .site-header::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: color-mix(in srgb, var(--cream) 80%, transparent);
    backdrop-filter: blur(16px);
    content: '';
    opacity: 0.94;
    transition: opacity 220ms ease;
  }

  .site-header.is-scrolled {
    box-shadow: 0 10px 30px rgba(36, 36, 36, 0.08);
  }

  .site-header.is-scrolled::before {
    background: color-mix(in srgb, var(--cream) 94%, transparent);
  }

  .header-inner {
    display: flex;
    height: 100%;
    align-items: center;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.7rem;
  }

  .brand-mark {
    display: grid;
    width: 38px;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--saffron) 55%, transparent);
    border-radius: 50%;
  }

  .brand-mark::before,
  .brand-mark::after,
  .brand-mark span {
    position: absolute;
    width: 20px;
    height: 20px;
    border: 1px solid var(--saffron);
    border-radius: 50%;
    content: '';
  }

  .brand-mark::after {
    width: 8px;
    height: 8px;
    border: 0;
    background: var(--forest);
  }

  .brand-copy {
    display: grid;
    line-height: 1.05;
  }

  .brand-copy strong {
    font-family: 'Lora', Georgia, serif;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .brand-copy small {
    margin-top: 0.22rem;
    color: var(--maroon);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .desktop-navigation {
    margin-left: auto;
  }

  .desktop-navigation ul {
    display: flex;
    align-items: center;
    gap: clamp(0.65rem, 1.2vw, 1.2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-navigation a {
    position: relative;
    display: block;
    padding-block: 0.8rem;
    font-size: 0.72rem;
    font-weight: 750;
    white-space: nowrap;
  }

  .desktop-navigation a::after {
    position: absolute;
    inset: auto 50% 0.35rem;
    height: 2px;
    background: var(--saffron);
    content: '';
    transition: inset 180ms ease;
  }

  .desktop-navigation a:hover::after,
  .desktop-navigation a[aria-current='page']::after {
    inset-inline: 0;
  }

  .header-donate {
    flex: 0 0 auto;
    padding: 0.8rem 1rem;
    border-radius: 999px;
    background: var(--saffron);
    color: var(--white);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .menu-toggle,
  .menu-close {
    display: none;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--cream);
    color: var(--ink);
    cursor: pointer;
  }

  .mobile-menu {
    position: fixed;
    z-index: 120;
    inset: 0;
    visibility: hidden;
  }

  .menu-backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(24, 31, 27, 0.55);
    opacity: 0;
    backdrop-filter: blur(4px);
    transition: opacity 220ms ease;
  }

  .mobile-panel {
    position: absolute;
    inset: 0 0 0 auto;
    display: flex;
    width: min(90vw, 420px);
    flex-direction: column;
    padding: 1.25rem 1.25rem max(1.5rem, env(safe-area-inset-bottom));
    background: var(--cream);
    box-shadow: -30px 0 70px rgba(21, 41, 31, 0.18);
    transform: translateX(105%);
    transition: transform 260ms cubic-bezier(0.22, 0.72, 0.22, 1);
  }

  .mobile-menu.is-open {
    visibility: visible;
  }

  .mobile-menu.is-open .menu-backdrop {
    opacity: 1;
  }

  .mobile-menu.is-open .mobile-panel {
    transform: none;
  }

  .mobile-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .mobile-panel nav {
    margin-block: 1rem auto;
  }

  .mobile-panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-panel a:not(.button) {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.72rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 65%, transparent);
    font-family: 'Lora', Georgia, serif;
    font-size: clamp(1.1rem, 4vw, 1.45rem);
    line-height: 1.2;
  }

  .mobile-panel a span {
    color: var(--saffron);
    font-family: 'Manrope', sans-serif;
    font-size: 0.62rem;
    font-weight: 800;
  }

  @media (max-width: 1160px) {
    .desktop-navigation {
      display: none;
    }

    .menu-toggle,
    .menu-close {
      display: grid;
    }

    .menu-toggle {
      margin-left: auto;
    }
  }

  @media (max-width: 520px) {
    .header-donate {
      display: none;
    }

    .brand-copy strong {
      font-size: 0.86rem;
    }
  }
</style>
