---
import ImpactCard from './ImpactCard.astro';

interface Item { title: string; description: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<div class="stats-strip">
  {items.map((item, index) => <ImpactCard {...item} index={index} />)}
</div>
<style>
  .stats-strip { display: grid; grid-template-columns: repeat(5, 1fr); }
  @media (max-width: 900px) { .stats-strip { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .stats-strip { grid-template-columns: 1fr; } }
</style>
